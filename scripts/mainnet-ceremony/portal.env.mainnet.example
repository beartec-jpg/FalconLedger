# Portal / Vercel — mainnet (no secrets in git)
# Copy to host secrets manager; set NEXT_PUBLIC_MAINNET_LIVE=true only at T0.

NEXT_PUBLIC_MAINNET_NAME=Falcon Ledger
# Must match scripts/mainnet-ceremony/NETWORK_ID.txt
NEXT_PUBLIC_MAINNET_NETWORK_ID=1026
NEXT_PUBLIC_MAINNET_RPC_URL=https://rpc.mainnet.example
NEXT_PUBLIC_MAINNET_DRIP_QXRP=100
# Keep false until T0 after split + consensus green
NEXT_PUBLIC_MAINNET_LIVE=false

MAINNET_RPC_URL=https://rpc.mainnet.example
MAINNET_FAUCET_ACCOUNT=
MAINNET_FAUCET_SECRET=
MAINNET_DRIP_AMOUNT_QXRP=100

FAUCET_CLAIMS_PER_DAY=5
FAUCET_COOLDOWN_SECONDS=3600

# Neon / Postgres — apply docs/sql/airdrop-schema.sql first
DATABASE_URL=
AIRDROP_ADMIN_TOKEN=
AIRDROP_VALIDATOR_ADDRESSES=

# Cron host
# NETWORK=mainnet
# PORTAL_BASE_URL=https://wallet.example

# Optional signer proxy
MAINNET_SIGNER_PROXY_URL=
MAINNET_SIGNER_PROXY_TOKEN=
