// ─── Required environment variables ──────────────────────────────────────────
// Copy this file to .env.local and fill in your values.
// NEVER commit .env.local to git.

# xrpld public RPC endpoint (HTTP, port 6005 by default on cloud nodes)
XRPLD_RPC_URL=http://YOUR_NODE_IP:6005

# Faucet wallet (holds testnet qXRP to distribute)
# For regtest: use genesis account. For production: use a dedicated funded account.
FAUCET_ACCOUNT=rHb9CJAWyB4rj91VRWn96DkukG4bwdtyTh
FAUCET_SECRET=snoPBrXtMeMyMHUVTgbuqAfg1SUTb

# Amount to send per drip (in qXRP, NOT drops)
DRIP_AMOUNT_QXRP=100

# Rate limiting: 1 request per window per IP and per account
RATE_LIMIT_REQUESTS=1
RATE_LIMIT_WINDOW_SECONDS=86400

# Upstash Redis (for distributed rate limiting on Vercel)
# Create a free database at https://console.upstash.com
# Or add via: vercel env add KV_REST_API_URL / KV_REST_API_TOKEN
KV_REST_API_URL=https://YOUR_UPSTASH_URL.upstash.io
KV_REST_API_TOKEN=YOUR_UPSTASH_TOKEN

# Public env vars (exposed to browser)
NEXT_PUBLIC_NETWORK_NAME=qXRP Testnet
NEXT_PUBLIC_NETWORK_ID=999
NEXT_PUBLIC_EXPLORER_URL=
