// qXRP: 32-bit fields (70-89 reserved for qXRP)
TYPED_SFIELD(sfBondStatus,               UINT32,    70) // 0=registered 1=bonded 2=unbonding
TYPED_SFIELD(sfCurrentBurnBps,           UINT32,    71) // dynamic burn fraction in bps
TYPED_SFIELD(sfEpochNumber,              UINT32,    72) // monotonic epoch counter
TYPED_SFIELD(sfUptimeBps,                UINT32,    73) // uptime score in bps
TYPED_SFIELD(sfVoteAccuracyBps,          UINT32,    74) // vote accuracy score in bps
TYPED_SFIELD(sfLatencyScoreBps,          UINT32,    75) // proposal latency score in bps
TYPED_SFIELD(sfConsistencyBps,           UINT32,    76) // participation consistency in bps
TYPED_SFIELD(sfSlashMultiplier,          UINT32,    77) // penalty multiplier 0-10000
TYPED_SFIELD(sfCompositeScore,           UINT32,    78) // weighted composite score in bps
TYPED_SFIELD(sfSlashCount,               UINT32,    79) // total slash events on this bond
TYPED_SFIELD(sfLastClaimedEpoch,         UINT32,    80) // last epoch from which reward claimed
TYPED_SFIELD(sfUnbondingStartLedger,     UINT32,    81) // ledger at which unbonding began
TYPED_SFIELD(sfEpochStartLedger,         UINT32,    82) // ledger at which this epoch started
TYPED_SFIELD(sfFeeVolumeEMA,             UINT32,    83) // smoothed fee volume (EMA, drops/ledger)
TYPED_SFIELD(sfAggregateCompositeScore,  UINT32,    84) // sum of all bonded composite scores
TYPED_SFIELD(sfSlashOffense,             UINT32,    85) // 1=double-sign 2=absence 3=invalid-vote
TYPED_SFIELD(sfProposalType,             UINT32,    86) // 1=burnBps governance param
TYPED_SFIELD(sfProposalValue,            UINT32,    87) // proposed new value
TYPED_SFIELD(sfProposalExpiry,           UINT32,    88) // ledger seq at which proposal expires
TYPED_SFIELD(sfProposalState,            UINT32,    89) // 0=open 1=passed 2=rejected
TYPED_SFIELD(sfVotedFor,                 UINT32,    90) // cumulative compositeScore voting yes
TYPED_SFIELD(sfVotedAgainst,             UINT32,    91) // cumulative compositeScore voting no
TYPED_SFIELD(sfLPAllocationBps,          UINT32,    92) // PoPL: vault-LP fraction of epoch emission
TYPED_SFIELD(sfAmmLPAllocationBps,       UINT32,    93) // PoPL: AMM-LP fraction of epoch emission
TYPED_SFIELD(sfNameStatus,               UINT32,    94) // AccountName: 0=active 1=releasing
// Bitcoin SPV light-client bridge
TYPED_SFIELD(sfBtcChainId,               UINT32,    95)
TYPED_SFIELD(sfBtcAnchorHeight,          UINT32,    96)
TYPED_SFIELD(sfBtcTipHeight,             UINT32,    97)
TYPED_SFIELD(sfBtcMinConfirmations,      UINT32,    98)
TYPED_SFIELD(sfBtcPaused,                UINT32,    99) // reserved; MVP always 0
TYPED_SFIELD(sfBtcHeight,                UINT32,   100)
TYPED_SFIELD(sfBtcVout,                  UINT32,   101)
TYPED_SFIELD(sfBtcDepositStatus,         UINT32,   102)
TYPED_SFIELD(sfBtcTxIndex,               UINT32,   103)
// BitVM peg-out / withdraw
TYPED_SFIELD(sfBtcWithdrawStatus,        UINT32,   104) // 0=pending 1=challenged 2=final 3=paid
TYPED_SFIELD(sfBtcChallengeEndLedger,    UINT32,   105)
TYPED_SFIELD(sfBtcWithdrawSeq,           UINT32,   106)

