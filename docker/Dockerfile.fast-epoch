#
# REHEARSAL ONLY — short epochs for emissions / ClaimReward soak.
# Do NOT use for real mainnet T0. Production image: docker/Dockerfile → mainnet-v1.
#
#   DOCKER_BUILDKIT=1 docker build -t qxrp/xrpld:mainnet-rehearsal-fast-epoch \
#     -f docker/Dockerfile.fast-epoch \
#     --build-arg QXRP_EPOCH_LEDGERS=256 \
#     --build-arg QXRP_FIRST_EMISSION_EPOCH=2 .

ARG CORES=4
ARG QXRP_EPOCH_LEDGERS=256
ARG QXRP_FIRST_EMISSION_EPOCH=2

FROM debian:bookworm AS builder

ARG CORES=4
ARG QXRP_EPOCH_LEDGERS=256
ARG QXRP_FIRST_EMISSION_EPOCH=2

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake ninja-build pkg-config git curl \
        python3 python3-pip libssl-dev \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --break-system-packages "conan>=2.17"

WORKDIR /src

COPY conanfile.py CMakeLists.txt ./
COPY src/libxrpl/protocol/BuildInfo.cpp ./src/libxrpl/protocol/BuildInfo.cpp
COPY conan/profiles/ ./conan/profiles/
COPY external/secp256k1-recipe/ ./external/secp256k1-recipe/
COPY external/ed25519-recipe/ ./external/ed25519-recipe/

RUN --mount=type=cache,target=/root/.conan2,id=qxrp-conan \
    conan profile detect --force \
    && sed -i 's/compiler.cppstd=gnu17/compiler.cppstd=gnu20/' ~/.conan2/profiles/default \
    && conan remote add --force --index 0 xrplf https://conan.ripplex.io \
    && mkdir -p /build \
    && cd /build \
    && conan install /src --output-folder=. --build=missing \
       -s build_type=Release \
       -o "xrpl/*:tests=False" \
       -o "xrpl/*:xrpld=True"

COPY . .

RUN --mount=type=cache,target=/root/.conan2,id=qxrp-conan \
    --mount=type=cache,target=/build,id=qxrp-build-fast-epoch \
    cd /build \
    && conan install /src --output-folder=. --build=missing \
       -s build_type=Release \
       -o "xrpl/*:tests=False" \
       -o "xrpl/*:xrpld=True" \
    && cmake /src \
       -DCMAKE_BUILD_TYPE=Release \
       -DCMAKE_TOOLCHAIN_FILE=build/generators/conan_toolchain.cmake \
       -DCMAKE_POLICY_DEFAULT_CMP0091=NEW \
       -Dxrpld=ON \
       -Dtests=OFF \
       -Dqxrp_epoch_override=${QXRP_EPOCH_LEDGERS} \
       -DCMAKE_CXX_FLAGS="-DQXRP_FIRST_EMISSION_EPOCH=${QXRP_FIRST_EMISSION_EPOCH}" \
       -G Ninja \
    && cmake --build . --target xrpld --parallel ${CORES} \
    && cp /build/xrpld /tmp/xrpld

FROM debian:bookworm-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
        libssl3 libstdc++6 curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1001 -s /bin/bash xrpld
COPY --from=builder /tmp/xrpld /usr/local/bin/xrpld
EXPOSE 5005 51235 8080
USER xrpld
WORKDIR /home/xrpld
ENTRYPOINT ["/usr/local/bin/xrpld"]
CMD ["--conf", "/cfg/xrpld.cfg"]
